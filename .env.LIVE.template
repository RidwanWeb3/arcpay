# ── ArcPay Agent — LIVE MODE environment reference ──────────────────────────
# Copy this file to `.env.local` and fill in the secrets you control.
# Missing values → the app automatically falls back to DEMO data so nothing breaks.

# ═══════════════════════════════════════════════════════════════════════════
# 1. GLOBAL MODE SWITCH
# ═══════════════════════════════════════════════════════════════════════════
# DEMO  → data is generated locally (safe for development, no API keys needed)
# LIVE  → data comes from real sources (Supabase tables + ARC on-chain + live API providers)
VITE_DATA_MODE=LIVE

# ═══════════════════════════════════════════════════════════════════════════
# 2. ARC NETWORK — defaults are already set in chains.ts; override here if needed
# ═══════════════════════════════════════════════════════════════════════════
# Default: Arc Mainnet (chain 5042) via Infura — already wired in code.
# Set to TESTNET to point at 5042002 during staging.
VITE_ARC_NETWORK=MAINNET

# Optional — override the official RPC / explorer endpoints:
# VITE_ARC_MAINNET_CHAIN_ID=5042
# VITE_ARC_MAINNET_RPC=https://arc-mainnet.infura.io/v3/b6bf7d3508c941499b10025c0776eaf8
# VITE_ARC_MAINNET_EXPLORER=https://arc-scan.org
# VITE_ARC_TESTNET_RPC=https://rpc.testnet.arc.network
# VITE_ARC_TESTNET_EXPLORER=https://testnet.arcscan.app

# ═══════════════════════════════════════════════════════════════════════════
# 3. WALLETCONNECT — enables mobile (Rainbow, MetaMask Mobile, Trust) via QR
# ═══════════════════════════════════════════════════════════════════════════
# Get a free project ID from https://cloud.walletconnect.com/
# Without this, only the browser-injected wallet (MetaMask/Rabby/Coinbase BW) works.
# VITE_WALLETCONNECT_PROJECT_ID=

# ═══════════════════════════════════════════════════════════════════════════
# 4. SUPABASE — stores services, agents, payments, activity rows in LIVE mode
# ═══════════════════════════════════════════════════════════════════════════
# Connect your Supabase project from the Lovable Cloud / IDE integrations panel
# OR set VITE_SUPABASE_URL and VITE_SUPABASE_PUBLISHABLE_KEY manually.
# The following PUBLIC tables must exist in the `public` schema:
#
#   public.services        — one row per agent-available service
#   public.agents          — one row per autonomous agent (incl. wallet address)
#   public.payments        — INSERT-only log of every payment attempt
#   public.activity        — append-only event stream
#
# SQL to replicate these tables is printed below.
#
VITE_SUPABASE_URL=
VITE_SUPABASE_PUBLISHABLE_KEY=

# SERVER-only Supabase service_role key (NOT for VITE_*; read by server RPCs)
# SUPABASE_SERVICE_ROLE_KEY=
# SUPABASE_URL=

# ═══════════════════════════════════════════════════════════════════════════
# 5. LIVE SERVICE PROVIDER API KEYS
# ═══════════════════════════════════════════════════════════════════════════
# Each provider that ArcPay integrates needs a bearer key in LIVE mode.
# Without a key the service still appears in the marketplace but its
# /execute step returns DEMO mock data (signing still works, no actual API call).
#
# Replicate (image/video generation + hosted models):
#   https://replicate.com/signin  → https://replicate.com/account/api-tokens
VITE_REPLICATE_API_TOKEN=

# OpenAI (GPT-4o, embeddings, audio, etc.):
#   https://platform.openai.com/api-keys
VITE_OPENAI_API_KEY=

# Anthropic Claude (Opus/Sonnet/Haiku):
#   https://console.anthropic.com/settings/keys
VITE_ANTHROPIC_API_KEY=

# Brave Search Agent API (pay-per-query, free tier available):
#   https://brave.com/search/api/ → "AI Search API"
VITE_BRAVE_API_KEY=

# CoinGecko / CoinMarketCap price feeds (used by DATA category services):
VITE_COINGECKO_API_KEY=
# VITE_COINMARKETCAP_API_KEY=

# ═══════════════════════════════════════════════════════════════════════════
# 6. DEPLOYMENT / BRAND OVERRIDES — optional
# ═══════════════════════════════════════════════════════════════════════════
# VITE_CONTRACT_ADDRESS=0x…    # once an ArcPay settlement contract is deployed
# VITE_BUY_URL=
# VITE_CHART_URL=
# VITE_X_URL=https://x.com/ArcPayAgent    # default: official ArcPay Agent X handle

